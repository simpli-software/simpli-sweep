<Window x:Class="Cleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cleaner.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Width="800" Height="680" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <vm:ByteSizeConverter x:Key="Bytes" />
  </Window.Resources>

  <Grid Margin="24,16,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Restart as administrator"
              Command="{Binding RestartAsAdminCommand}"
              Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}"
              ToolTip="Some Windows categories and all-users startup programs can only be changed with administrator rights." />
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Free up space safely. You see everything before it is deleted." Opacity="0.75" />
      </StackPanel>
    </DockPanel>

    <TabControl Grid.Row="1">
      <!-- Clean -->
      <TabItem Header="Clean">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                    Visibility="{Binding SettingsNeedReview, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="I've checked my settings" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding AcknowledgeSettingsCommand}" />
                <TextBlock Text="{Binding Settings.Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Button DockPanel.Dock="Right" Content="Scan again" Command="{Binding ScanCommand}" />
            <ProgressBar Height="4" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          </DockPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Source={StaticResource Grouped}}"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Cleaning categories">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="4,12,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                            IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                            AutomationProperties.Name="{Binding Name}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0">
                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DetailText}" Opacity="0.7" FontSize="12" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Clean" MinWidth="120" Padding="16,6"
                    Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding CleanCommand}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedText}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Startup -->
      <TabItem Header="Startup" DataContext="{Binding Startup}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Text="Programs that start when you sign in. Fewer means a faster start."
                       VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
          </DockPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Startup programs">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                <Grid Margin="0,4" ToolTip="{Binding Command}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Location, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SignatureText}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,4,0">
                    <TextBlock Text="{Binding AdminNote}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                              Content="Starts with Windows"
                              AutomationProperties.Name="{Binding Name}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </TabItem>
      <!-- Disk (read-only) -->
      <TabItem Header="Disk" DataContext="{Binding Disk}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Right" Content="Scan" Margin="8,0,0,0" Command="{Binding ScanCommand}" />
            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                      DisplayMemberPath="Display" AutomationProperties.Name="Drive" />
          </DockPanel>

          <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="Up" Margin="0,0,8,0" Command="{Binding UpCommand}" />
            <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Folders in the current folder, largest first -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Folders}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Largest folders">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Hyperlink Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}">
                          <Run Text="{Binding Name, Mode=OneWay}" />
                        </Hyperlink>
                      </TextBlock>
                      <ProgressBar Height="4" Margin="0,4,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" />
                      <Button Content="Show" Margin="8,0,0,0" Padding="8,2"
                              Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding Path}" ToolTip="Show in File Explorer" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Largest files on the drive -->
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Largest files" FontWeight="SemiBold" Margin="4,0,0,6" />
              <ListBox ItemsSource="{Binding LargestFiles}" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Largest files">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2" ToolTip="{Binding Path}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,2"
                              Content="{Binding Size, Converter={StaticResource Bytes}}"
                              Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding Path}" ToolTip="Show in File Explorer" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Static vm:DiskUsageViewModel.WindowsNote}" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
                       Visibility="{Binding ShowWindowsNote, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <!-- Settings -->
      <TabItem Header="Settings" DataContext="{Binding Settings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings can only make cleaning more careful, never less." Opacity="0.75" Margin="0,0,0,16" TextWrapping="Wrap" />

            <TextBlock Text="Only remove files" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding AgeChoices}" SelectedItem="{Binding SelectedAge}"
                      DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="280"
                      AutomationProperties.Name="Minimum file age" />
            <TextBlock Text="Categories that already wait longer keep their own setting." Opacity="0.7" FontSize="12" Margin="0,4,0,20" TextWrapping="Wrap" />

            <TextBlock Text="Never clean these folders" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding ExcludedFolders}" MinHeight="60" MaxHeight="180"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Excluded folders">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2"
                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Add folder…" HorizontalAlignment="Left" Margin="0,8,0,20" Command="{Binding AddFolderCommand}" />

            <TextBlock Text="Never clean files named" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding ExcludedPatterns}" MinHeight="60" MaxHeight="180"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Excluded file patterns">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2"
                            Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0" Command="{Binding AddPatternCommand}" />
              <TextBox Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="New file pattern, for example *.log" />
            </DockPanel>
            <TextBlock Text="For example *.log or report-*.pdf" Opacity="0.7" FontSize="12" Margin="0,4,0,20" />

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
