// Browser caches only. Cookies, history and sessions are deliberately not touched in v1.
// Close the browser first; files it has open are skipped.
[
  {
    "id": "edge-cache",
    "name": "Microsoft Edge cache",
    "description": "Cached web pages and images for all Edge profiles.",
    "category": "Browsers",
    "targets": [
      { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache\\Cache_Data", "recursive": true },
      { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache", "recursive": true },
      { "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache", "recursive": true }
    ]
  },
  {
    "id": "chrome-cache",
    "name": "Google Chrome cache",
    "description": "Cached web pages and images for all Chrome profiles.",
    "category": "Browsers",
    "targets": [
      { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache\\Cache_Data", "recursive": true },
      { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache", "recursive": true },
      { "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache", "recursive": true }
    ]
  },
  {
    "id": "brave-cache",
    "name": "Brave cache",
    "description": "Cached web pages and images for all Brave profiles.",
    "category": "Browsers",
    "targets": [
      { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache\\Cache_Data", "recursive": true },
      { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "recursive": true },
      { "path": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache", "recursive": true }
    ]
  },
  {
    "id": "firefox-cache",
    "name": "Firefox cache",
    "description": "Cached web pages and images for all Firefox profiles.",
    "category": "Browsers",
    "targets": [
      { "path": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2", "recursive": true }
    ]
  }
]
